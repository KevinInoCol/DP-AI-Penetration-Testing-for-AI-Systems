# ============================================
# MODELO LLM PRINCIPAL (agente conversacional)
# ============================================
# Cambia estas 4 variables para alternar entre OpenAI y un modelo local
# para el agente principal (el que conversa con el usuario).
#
# ── OpenAI (cloud) ──
#   LLM_MODEL=gpt-4.1
#   LLM_PROVIDER=openai
#   LLM_BASE_URL=https://api.openai.com/v1
#   LLM_API_KEY=sk-proj-...              # usa la misma de OPENAI_API_KEY
#
# ── LMStudio (local, API compatible OpenAI) ──
#   LLM_MODEL=google/gemma-4-e2b         # el "API Identifier" que muestra LMStudio
#   LLM_PROVIDER=openai                  # LMStudio expone endpoint OpenAI-compatible
#   LLM_BASE_URL=http://localhost:1234/v1
#   LLM_API_KEY=lm-studio                # LMStudio no valida la key (cualquier string)
#
# ── Ollama (local) ──
#   LLM_MODEL=llama3.1:8b
#   LLM_PROVIDER=ollama
#   (LLM_BASE_URL y LLM_API_KEY no son necesarias para Ollama por defecto)
# ============================================
LLM_MODEL=google/gemma-4-e2b
LLM_PROVIDER=openai
LLM_BASE_URL=http://localhost:1234/v1
LLM_API_KEY=lm-studio

# ============================================
# OPENAI API KEY (independiente del LLM principal)
# ============================================
# Se usa para:
#   - Embeddings del RAG (tools/Base_de_conocimiento.py → text-embedding-ada-002)
#   - LLM-as-a-Judge evaluador (evaluation/llm_judge.py → gpt-4o-mini)
# Mantenla aunque el agente principal corra en local (LMStudio/Ollama).
OPENAI_API_KEY=sk-proj-...kkkkkkkkkkkkkkkkkkkkkkkkkkkkk

#Memoria 1: PostgreSQL para mi Histórico de Conversación (Supabase)
DB_USER=postgres.<project-ref>
DB_PASSWORD=kkkkkkkkkkkkkkkkkkkkk
DB_HOST=aws-1-us-east-2.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres

#Memoria 2: Base de Conocimiento (RAG)(Supabase)
#SUPABASE_URL=https://<project-ref>.supabase.co
#SUPABASE_SERVICE_KEY=

#Memoria 2: Base de Conocimiento (RAG)(Pinecone)
PINECONE_API_KEY=pcsk_...
PINECONE_INDEX_NAME=

#Conexion a la Web
TAVILY_API_KEY=

# Variables para Chatwoot
CHATWOOT_BASE_URL=https://<tu-instancia>.easypanel.host
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_API_ACCESS_TOKEN=
# Para que responda el agente de IA
#CHATWOOT_BOT_LABEL=atiende-ia
CHATWOOT_BOT_LABEL=ia-off

# Zona horaria del agente
AGENT_TIMEZONE=America/Lima

# GROQ API Key
GROQ_API_KEY=gsk_...

# Langfuse — obtén las keys en https://cloud.langfuse.com
LANGFUSE_SECRET_KEY="sk-lf-..."
LANGFUSE_PUBLIC_KEY="pk-lf-..."
LANGFUSE_BASE_URL="https://us.cloud.langfuse.com"
